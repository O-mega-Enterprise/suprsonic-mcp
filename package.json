    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": ["mcp", "suprsonic", "ai-agent", "unified-api", "tools", "model-context-protocol"]
